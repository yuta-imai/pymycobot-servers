{
  "name": "@yuta-imai/mycobot-mcp-server",
  "version": "0.1.0",
  "description": "Model Context Protocol server for controlling a MyCobot arm via its REST API. Designed for Claude Desktop.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mycobot",
    "robotics",
    "claude"
  ],
  "license": "Apache-2.0",
  "author": "Yuta Imai",
  "type": "module",
  "bin": {
    "mycobot-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuta-imai/pymycobot-servers.git",
    "directory": "mcp-server"
  },
  "scripts": {
    "generate": "openapi-typescript ../mycobot_api_spec.yaml --default-non-nullable false -o src/generated/api-types.ts",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run generate && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "openapi-fetch": "^0.13.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "openapi-typescript": "^7.4.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
